# ============================================================
# Patient data: must never enter the repository
# ============================================================
# Anchored to the repository root on purpose: an unanchored "data/" also matched source folders
# such as app/lib/data/ and silently kept code out of git. Images and PDFs are blocked
# everywhere below, whatever folder they are in.
/data/
/datasets/
/prescriptions/
/uploads/
/patient_data/
/ml/data/
/backend/eval/out/
/backend/.hypothesis/
*.dcm

# Prescription photos and scans, so none are committed by accident.
# Fictional sample images may go in docs/samples/.
*.jpg
*.jpeg
*.png
*.heic
*.webp
*.pdf
!docs/samples/**
!app/assets/**
!app/android/app/src/main/res/**

# ============================================================
# Secrets: API keys, passwords
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key
secrets/
service-account*.json
google-services.json
GoogleService-Info.plist

# ============================================================
# Large model files (store them on Hugging Face)
# ============================================================
*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.onnx
# The fine-tuned Bangla OCR model the backend ships with (7.7 MB, see backend/models/README.md)
!backend/models/rec.onnx
ml/checkpoints/
ml/outputs/
ml/models/

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ============================================================
# Node.js
# ============================================================
node_modules/
dist/

# ============================================================
# Flutter / Dart
# ============================================================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
*.iml
local.properties
key.properties
*.jks
*.keystore

# ============================================================
# Supabase
# ============================================================
supabase/.branches/
supabase/.temp/

# ============================================================
# OS / Editor
# ============================================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Shared signing key for pilot APKs only: deliberately public, never for Play Store uploads
!app/android/pilot.keystore
