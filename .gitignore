!backend/app/prescriptions/
uploads/
patient_data/
ml/data/
backend/eval/out/
*.dcm

# Prescription photos and scans, so none are committed by accident.
# Fictional sample images may go in docs/samples/.
*.jpg
*.jpeg
*.png
*.heic
*.webp
*.pdf
!docs/samples/**
!app/assets/**
!app/android/app/src/main/res/**

