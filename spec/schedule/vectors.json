    {"id": "error_meal_order", "settings": {"lunch": "07:00"}, "medicine": {"dose_pattern": "1+0+0", "timing": "after_meal", "duration_days": 7, "start": "2026-11-26T00:00"}, "expect": {"error": "invalid_meal_times"}},
