    },
    {
      "id": "slash_fraction",
      "medicine": {"dose_pattern": "0+0+1/2", "timing": "not_specified", "duration_days": 2, "start": "2026-11-26T00:00"},
      "expect": {"daily_times": ["21:30 0.5 night"], "total_doses": 2, "last_dose_at": "2026-11-27T21:30"}
    },
