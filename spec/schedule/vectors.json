{
  "spec": "docs/SCHEDULE_SPEC.md",
  "version": 1,
  "notes": [
    "All datetimes are wall-clock times in the user's time zone, formatted YYYY-MM-DDTHH:MM.",
    "daily_times entries are 'HH:MM amount slot'; a '+1' after the time means the next calendar day.",
    "Default settings: breakfast 08:00, lunch 13:30, evening 17:30, dinner 21:30, bedtime 22:30, offsets -30/+15/-60, group window 10.",
    "2026-11-26 is a Thursday.",
    "Expected values are derived by hand from the spec, not generated by an implementation."
  ],
  "medicine_cases": [
    {
      "id": "before_meal_twice_daily_30_days",
      "medicine": {"dose_pattern": "1+0+1", "timing": "before_meal", "duration_days": 30, "start": "2026-11-26T07:00"},
      "expect": {"daily_times": ["07:30 1 morning", "21:00 1 night"], "doses_per_day": 2, "total_doses": 60,
                 "first_dose_at": "2026-11-26T07:30", "last_dose_at": "2026-12-25T21:00"}
    },
    {
      "id": "afternoon_start_keeps_full_dose_count",
      "medicine": {"dose_pattern": "1+0+1", "timing": "after_meal", "duration_days": 5, "start": "2026-11-26T15:00"},
      "expect": {"daily_times": ["08:15 1 morning", "21:45 1 night"], "total_doses": 10,
                 "first_dose_at": "2026-11-26T21:45", "last_dose_at": "2026-12-01T08:15"}
    },
    {
      "id": "three_times_after_meal",
      "medicine": {"dose_pattern": "1+1+1", "timing": "after_meal", "duration_days": 5, "start": "2026-11-26T06:00"},
      "expect": {"daily_times": ["08:15 1 morning", "13:45 1 noon", "21:45 1 night"], "doses_per_day": 3, "total_doses": 15,
