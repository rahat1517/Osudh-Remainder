# Copy this file to .env and fill in real values.
# Never commit .env.

ANTHROPIC_API_KEY=
# Prescription reader model and effort (defaults shown)
# READER_MODEL=claude-opus-5-5
# READER_EFFORT=high
# development | production (production refuses to start without authentication)
ENVIRONMENT=development
# Token verification: project URL (JWKS signing keys) and/or legacy HS256 JWT secret
SUPABASE_URL=
# SUPABASE_JWT_SECRET=
# Optional error monitoring (personal data is scrubbed)
# SENTRY_DSN=

# Server jobs (missed-dose alerts): direct database URL and Firebase service account
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# FCM_SERVICE_ACCOUNT_FILE=/secrets/fcm-service-account.json

# SMS and voice-call reminders (optional; without them the job only logs messages)
# SMS_GATEWAY_URL=https://sms-provider.example/api/send
# SMS_API_KEY=
# SMS_SENDER_ID=
# VOICE_GATEWAY_URL=https://ivr-provider.example/api/call
# VOICE_API_KEY=
# ESCALATION_MONTHLY_BUDGET_BDT=5000
